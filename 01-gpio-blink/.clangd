# clangd takes the compile flags from build/compile_commands.json.
# The ones below are GCC-only, so clangd warns about them and they are removed.
# System headers come from the toolchain itself: clangd queries the compiler,
# which needs --query-driver in the editor config (kept out of this repo).
CompileFlags:
  CompilationDatabase: build
  Remove:
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=*
    - -fno-malloc-dce
